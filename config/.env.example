# Alan API keys
# ---------------------------------------------------------------------------
# Copy this file to `.env` (same folder) and fill in the keys you want to use.
# Alan registers every backend that has a key, and the router chooses between
# them by `priority` in settings.toml -- lower wins, and every cloud provider
# ships at 0 against the local model's 10. So the key you set here is the one
# that answers; with no key at all Alan falls back to the local Ollama model.
#
# Two properties worth knowing, because both are easy to undo by accident:
#
#   * This file is excluded from backups (verify_tree's SKIP_EXACT), so a key
#     never travels with the rest of the tree.
#   * Every name below is listed in interfaces.types._SECRET_ENV_NAMES, so the
#     key is masked before it can reach a log line or memory -- including in a
#     provider's own error message. A test asserts that this file's names and
#     that list stay in step, so adding a provider cannot add an unmasked key.
#
# Vibecoder reads its OWN env file (~/.vibecoder/.env), not this one. If you
# want both tools to use Groq, set GROQ_API_KEY in both places.
# ---------------------------------------------------------------------------

# Groq -- free-tier key, 8,000 tokens/min, cheapest option for coding work
GROQ_API_KEY=

# OpenAI (also used for any OpenAI-compatible endpoint via base_url)
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# OpenRouter -- one key reaches many models; ids look like "vendor/model"
OPENROUTER_API_KEY=

# Optional: override the Ollama host that Alan talks to
# OLLAMA_HOST=http://127.0.0.1:11435
