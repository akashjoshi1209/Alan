# =============================================================================
# Alan - Personal AI Operating System
# Environment Configuration Template
# Copy to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Alan
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
SECRET_KEY=your-secret-key-generate-with-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL (production)
DATABASE_URL=postgresql+asyncpg://alan:password@localhost:5432/alan
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# SQLite (development fallback)
SQLITE_URL=sqlite+aiosqlite:///./alan.db

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# -----------------------------------------------------------------------------
# Vector Database
# -----------------------------------------------------------------------------
# ChromaDB (local)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=alan_memory

# Pinecone (cloud alternative)
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=
# PINECONE_INDEX=alan-memory

# Weaviate (cloud alternative)
# WEAVIATE_URL=http://localhost:8080
# WEAVIATE_API_KEY=

# -----------------------------------------------------------------------------
# AI Providers - API Keys
# -----------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google (Gemini)
GOOGLE_API_KEY=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=

# Cohere
COHERE_API_KEY=

# Mistral
MISTRAL_API_KEY=

# Groq
GROQ_API_KEY=

# Together AI
TOGETHER_API_KEY=

# Replicate
REPLICATE_API_TOKEN=

# Hugging Face
HF_TOKEN=
HF_HOME=~/.cache/huggingface

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELS=llama3,llama3:70b,mixtral,codellama

# -----------------------------------------------------------------------------
# AI Provider Settings
# -----------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_EMBEDDING_PROVIDER=ollama
DEFAULT_EMBEDDING_MODEL=nomic-embed-text
DEFAULT_CHAT_MODEL=llama3
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4096
DEFAULT_TOP_P=1.0

# -----------------------------------------------------------------------------
# Memory & Embeddings
# -----------------------------------------------------------------------------
EMBEDDING_DIMENSION=768
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MEMORY_TOP_K=10
MEMORY_SIMILARITY_THRESHOLD=0.75
VECTOR_DB=chroma

# -----------------------------------------------------------------------------
# Agent Configuration
# -----------------------------------------------------------------------------
DEFAULT_AGENT=assistant
MAX_AGENT_STEPS=10
AGENT_TIMEOUT=300
MAX_CONCURRENT_AGENTS=5

# -----------------------------------------------------------------------------
# Tool Configuration
# -----------------------------------------------------------------------------
TOOL_TIMEOUT=60
MAX_TOOL_CALLS_PER_STEP=5
ENABLE_CODE_EXECUTION=true
CODE_EXECUTION_TIMEOUT=30
SANDBOX_IMAGE=python:3.11-slim

# -----------------------------------------------------------------------------
# MCP (Model Context Protocol)
# -----------------------------------------------------------------------------
MCP_ENABLED=true
MCP_HOST=0.0.0.0
MCP_PORT=3000
MCP_TRANSPORT=stdio
MCP_SERVERS_CONFIG=config/mcp_servers.yaml

# -----------------------------------------------------------------------------
# Voice Configuration
# -----------------------------------------------------------------------------
VOICE_ENABLED=true
WAKE_WORD=hey alan
WAKE_WORD_SENSITIVITY=0.5
STT_PROVIDER=faster-whisper
STT_MODEL=base.en
TTS_PROVIDER=pyttsx3
TTS_VOICE=en_US
AUDIO_DEVICE_INDEX=0
SAMPLE_RATE=16000
VAD_THRESHOLD=0.5
SILENCE_DURATION=1.5

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_FORMAT=json
LOG_FILE=logs/alan.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10
LOG_LEVEL_CONSOLE=INFO
LOG_LEVEL_FILE=DEBUG

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
API_KEY_ENABLED=true
JWT_SECRET_KEY=your-jwt-secret-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,tauri://localhost
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# -----------------------------------------------------------------------------
# Telemetry (Optional)
# -----------------------------------------------------------------------------
TELEMETRY_ENABLED=false
SENTRY_DSN=
OTEL_ENDPOINT=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_API=true
ENABLE_CLI=true
ENABLE_VOICE=true
ENABLE_MCP=true
ENABLE_METRICS=false